# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Application Settings
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Analytics
NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Optional: Sentry for error tracking
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn

# Email уведомления через Supabase
# Адрес администратора для уведомлений
ADMIN_EMAIL=admin@prostoburo.com

# Supabase настройки (уже должны быть настроены)
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Другие настройки проекта
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# === EMAIL НАСТРОЙКИ ===

# Вариант 1: Resend API (РЕКОМЕНДУЕТСЯ - работает через HTTP, не требует SMTP портов)
# Бесплатно 3000 писем/месяц. Получить ключ: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Вариант 2: Yandex.Mail SMTP (требует открытые порты 465/587)
# Укажите ваш ящик и пароль приложения (создается в Яндекс.Паспорте)
YANDEX_EMAIL=golkonst@yandex.ru
YANDEX_PASSWORD=your_yandex_app_password